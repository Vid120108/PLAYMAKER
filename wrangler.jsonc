{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playmaker",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playmaker-db",
      "database_id": "20ec6d22-f8bb-404f-87d3-b30780f61229"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}